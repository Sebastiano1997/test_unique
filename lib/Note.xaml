<Window x:Class="WpfFilterExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtro clienti"
        Height="600" Width="900">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="FILTRI AVANZATI"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <WrapPanel Margin="0,0,0,10">

                <ComboBox x:Name="FieldCombo"
                          Width="130"
                          SelectedIndex="0"
                          Margin="0,0,5,0">
                    <ComboBoxItem Content="Nome"/>
                    <ComboBoxItem Content="Città"/>
                    <ComboBoxItem Content="Importo"/>
                </ComboBox>

                <ComboBox x:Name="OperatorCombo"
                          Width="130"
                          SelectedIndex="0"
                          Margin="0,0,5,0">
                    <ComboBoxItem Content="Contiene"/>
                    <ComboBoxItem Content="Uguale"/>
                    <ComboBoxItem Content="Maggiore"/>
                    <ComboBoxItem Content="Minore"/>
                </ComboBox>

                <TextBox x:Name="ValueText"
                         Width="150"
                         Height="25"
                         Margin="0,0,5,0"/>

                <Button Content="Aggiungi filtro"
                        Padding="10,3"
                        Click="AddFilter_Click"/>

            </WrapPanel>


            <ItemsControl x:Name="FilterList"
              Height="110"
              Margin="0,0,0,10">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding}"
                           VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                        Content="Elimina"
                        Padding="8,2"
                        Margin="5,0,0,0"
                        Click="DeleteFilter_Click"
                        Tag="{Binding}"/>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>


            <WrapPanel>
                <Button Content="APPLICA"
                        Width="100"
                        Margin="0,0,5,0"
                        Click="Apply_Click"/>

                <Button Content="RESET"
                        Width="100"
                        Click="Reset_Click"/>
            </WrapPanel>

        </StackPanel>

        <DataGrid x:Name="CustomerGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserSortColumns="True"/>

    </Grid>
</Window>
