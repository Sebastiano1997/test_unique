<Window x:Class="WpfFilterExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtro clienti"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FILTRI -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <StackPanel>

                <TextBlock Text="FILTRI AVANZATI"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#263238"
                           Margin="0,0,0,15"/>

                <!-- INSERIMENTO FILTRO -->
                <WrapPanel Margin="0,0,0,15">

                    <ComboBox x:Name="FieldCombo"
                              Width="180"
                              Height="35"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"/>

                    <ComboBox x:Name="OperatorCombo"
                              Width="140"
                              Height="35"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center"/>

                    <TextBox x:Name="ValueText"
                             Width="180"
                             Height="35"
                             Padding="8"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"/>

                    <Button Content="+ Aggiungi filtro"
                            Height="35"
                            Padding="15,5"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="AddFilter_Click"/>

                </WrapPanel>

                <!-- ELENCO FILTRI -->
                <TextBlock Text="Condizioni inserite"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Border BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8"
                        Background="#FAFAFA">

                    <ScrollViewer MaxHeight="140"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl x:Name="FilterList">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Grid Margin="2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#334155"
                                                   FontSize="13"/>

                                        <Button Grid.Column="1"
                                                Content="Elimina"
                                                Tag="{Binding}"
                                                Click="DeleteFilter_Click"
                                                Padding="8,3"
                                                Background="#FEE2E2"
                                                Foreground="#B91C1C"
                                                BorderThickness="0"
                                                Cursor="Hand"/>

                                    </Grid>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Border>

                <!-- PULSANTI -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">

                    <Button Content="Applica filtri"
                            Width="120"
                            Height="35"
                            Margin="0,0,8,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Apply_Click"/>

                    <Button Content="Reset"
                            Width="90"
                            Height="35"
                            Background="#E2E8F0"
                            Foreground="#334155"
                            BorderThickness="0"
                            Click="Reset_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- TABELLA -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="10"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <DataGrid x:Name="CustomerGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="White"
                      BorderThickness="0"
                      FontSize="13"
                      RowHeight="35"
                      ColumnHeaderHeight="40"/>

        </Border>

    </Grid>

</Window>
